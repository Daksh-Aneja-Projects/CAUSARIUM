{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "causarium/backend/.venv_311/Scripts/python.exe",
      "runtimeArgs": [
        "-m", "uvicorn", "backend.api.main:app",
        "--app-dir", "causarium",
        "--host", "127.0.0.1",
        "--port", "8000"
      ],
      "port": 8000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "causarium/frontend", "run", "dev", "--", "--port", "5173", "--strictPort"],
      "port": 5173
    }
  ]
}
