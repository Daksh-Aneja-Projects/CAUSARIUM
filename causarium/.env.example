# === LLM Provider ===
# "ollama" (default, local, no keys needed) or "hosted" (Anthropic/OpenAI).
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434

# Role-based models (Ollama shown; override for hosted providers).
LLM_DEFAULT_MODEL=ollama_chat/llama3.1:8b
LLM_FALLBACK_MODEL=ollama_chat/mistral:7b-instruct-v0.3-q4_K_M
LLM_CAUSAL_MODEL=ollama_chat/qwen2.5-coder:7b
LLM_FAST_MODEL=ollama_chat/llama3.2:1b
LLM_EMBED_MODEL=ollama/nomic-embed-text
# Force deterministic heuristic policy (no LLM) when true; auto if unset.
# LLM_OFFLINE_MODE=false

# === LLM API Keys (only needed when LLM_PROVIDER=hosted) ===
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# === Database Connections ===
POSTGRES_USER=causarium
POSTGRES_PASSWORD=password
POSTGRES_DB=causarium
POSTGRES_URL=postgresql+asyncpg://causarium:password@postgres:5432/causarium

REDIS_URL=redis://redis:6379/0

NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_URL=bolt://neo4j:7687

QDRANT_URL=http://qdrant:6333

# === Application Secrets ===
JWT_SECRET_KEY=change_me_to_a_secure_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# === Celery Config ===
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/1

# === App Settings ===
ENVIRONMENT=development
LOG_LEVEL=INFO
TENANT_MODE=single
